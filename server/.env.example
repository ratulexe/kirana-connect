PORT=5000
NODE_ENV=development
# Origins allowed to call this API from a browser, comma separated.
# 5173 consumer, 5174 store portal, 5175 reserved for the future admin panel.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Server-side Supabase credentials.
SUPABASE_URL=

# Public discovery endpoints use the anon key so row level security still
# applies to them. Same value as VITE_SUPABASE_ANON_KEY in the root .env.
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY bypasses RLS - keep it out of the frontend,
# out of any VITE_ variable, and out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# AI Business Advisor (Module 11). Server-side only -- never exposed as a
# VITE_ variable, never sent to the Portal. Leave AI_ADVISOR_API_KEY blank to
# run without the advisor; the deterministic report works fully either way.
AI_ADVISOR_PROVIDER=gemini
AI_ADVISOR_API_KEY=
# gemini-3.5-flash's free tier is capped at 20 requests/day; -lite has more headroom.
AI_ADVISOR_MODEL=gemini-3.5-flash-lite

# Location autocomplete (search-as-you-type in the Entrepreneur location
# field). Server-side only. Leave GEOAPIFY_API_KEY blank to run without
# autocomplete -- manual typing plus the existing submit-time Nominatim
# resolution keeps working unaffected.
LOCATION_AUTOCOMPLETE_PROVIDER=geoapify
GEOAPIFY_API_KEY=
