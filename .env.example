# Base URL of the Kirana Connect Express API.
# Customer discovery reads go through the API, not straight to Supabase.
VITE_API_BASE_URL=http://localhost:5000

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional canonical consumer URL for Supabase email confirmation and password
# reset redirects. If omitted, the app uses window.location.origin.
VITE_APP_URL=

# Store Portal is a separate application (apps/store), deployed separately.
# The consumer footer links to it rather than hardcoding a domain.
VITE_STORE_PORTAL_URL=http://localhost:5174

# Entrepreneur Portal is a separate application (apps/portal), deployed
# separately. The consumer footer's "Analyze your business" link points here.
VITE_ENTREPRENEUR_PORTAL_URL=http://localhost:5176/entrepreneur
