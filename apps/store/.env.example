# Shared Express API. Store Portal calls it with a Supabase access token.
VITE_API_BASE_URL=http://localhost:5000

# Supabase project. The ANON key is the only key that may appear here:
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to a Vite application.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where Supabase sends the user after they confirm their email.
VITE_AUTH_REDIRECT_URL=http://localhost:5174/login
