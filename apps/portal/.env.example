# Shared Express API. Every Portal request (Entrepreneur intake, location
# autocomplete, analysis modules, AI Advisor) goes through this backend --
# Portal never talks to Supabase or any external provider directly.
VITE_API_BASE_URL=http://localhost:5000

# Optional override for the Consumer Platform link on the gateway and in the
# Entrepreneur footer. If omitted, the app already falls back to the right
# URL for dev vs. production (see src/config/urls.js) -- only set this if the
# Consumer app is deployed somewhere other than the documented production URL.
VITE_CONSUMER_APP_URL=
