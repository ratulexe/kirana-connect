# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment (frontend root and server/ - patterns match at any depth)
.env
.env.local
.env.*.local
.env.development
.env.production
server/.env
!.env.example
!server/.env.example

# Claude Code local tooling: launch.json is fine to keep, but a worktree
# created by an agent run is a second full checkout with its own branch --
# never something that belongs inside a commit to this repo.
.claude/

# Supabase CLI local project cache -- regenerated on every `supabase` command,
# machine-specific, never meant to be committed.
supabase/.temp/
